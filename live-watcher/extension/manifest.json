{
  "manifest_version": 3,
  "name": "MyTutor Live Watcher",
  "version": "0.3.4",
  "description": "Persistent local MyTutor request detection. No cloud scheduler.",
  "minimum_chrome_version": "105",
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://www.mytutor.co.uk/tutors/secure/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  }
}
